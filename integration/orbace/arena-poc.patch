+    expect(solvedResponse.statusCode).toBe(200);
+    expect(solvedResponse.json().status).toBe('RESULT');
+
+    const persisted = await prisma.arenaSession.findUniqueOrThrow({
+      where: { id: dbSessionId }, include: { rounds: true, votes: true, events: true },
+    });
+    expect(persisted.votes).toHaveLength(1);
+    expect(persisted.rounds[0].solution).toBe(puzzleSolution);
+    expect(persisted.rounds[0].result).toBe('HOST');
+    expect(persisted.events.map((event) => event.version)).toEqual([1, 2, 3, 4, 5]);
+  }, 15_000);
+
+  it('plays the persisted route journey from a real same-origin browser', async () => {
+    const address = await app.listen({ host: '127.0.0.1', port: 0 });
+    const browser = await puppeteer.launch({ headless: true });
+    try {
+      const page = await browser.newPage();
+      await page.goto(`${address}/__arena_e2e`);
+      const journey = await page.evaluate(async (solution) => {
+        const createdResponse = await fetch('/api/arena/sessions', {
+          method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ defaultPreset: 'quick' }),
+        });
+        const created = await createdResponse.json();
+        const voteResponse = await fetch(`/api/arena/sessions/${created.id}/votes`, {
+          method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ choice: 'standard' }),
+        });
+        await fetch('/__arena_e2e/close-ballot', {
+          method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ sessionId: created.id }),
+        });
+        const readyResponse = await fetch(`/api/arena/sessions/${created.id}`);
+        const ready = await readyResponse.json();
+        const startResponse = await fetch(`/api/arena/sessions/${created.id}/start`, {
+          method: 'POST', headers: { 'content-type': 'application/json', 'idempotency-key': 'arena-browser-start-1' },
+          body: JSON.stringify({ expectedVersion: ready.version }),
+        });
+        const started = await startResponse.json();
+        const publicResponse = await fetch(`/api/arena/sessions/${created.id}`);
+        const publicBody = await publicResponse.text();
+        const hostResponse = await fetch(`/api/arena/sessions/${created.id}/host`);
+        const hostBody = await hostResponse.text();
+        const solveResponse = await fetch(`/api/arena/sessions/${created.id}/solve`, {
+          method: 'POST', headers: { 'content-type': 'application/json', 'idempotency-key': 'arena-browser-solve-1' },
+          body: JSON.stringify({ expectedVersion: started.version, board: solution }),
+        });
+        return {
+          sessionId: created.id as string,
+          createdStatus: createdResponse.status,
+          voteStatus: voteResponse.status,
+          readyStatus: ready.status,
+          startStatus: startResponse.status,
+          preset: started.round?.preset,
+          publicBody,
+          hostBody,
+          solveStatus: solveResponse.status,
+          result: (await solveResponse.json()).status,
+        };
+      }, puzzleSolution);
+
+      sessionIds.push(journey.sessionId);
+      expect(journey.createdStatus).toBe(201);
+      expect(journey.voteStatus).toBe(200);
+      expect(journey.readyStatus).toBe('READY');
+      expect(journey.startStatus).toBe(200);
+      expect(journey.preset).toBe('standard');
+      expect(journey.publicBody).not.toContain(puzzleSolution);
+      expect(journey.publicBody).not.toContain('arena-test-host');
+      expect(journey.hostBody).not.toContain(puzzleSolution);
+      expect(journey.solveStatus).toBe(200);
+      expect(journey.result).toBe('RESULT');
+    } finally {
+      await browser.close();
+    }
+  }, 20_000);
+});
