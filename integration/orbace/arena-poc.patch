+// Approximate audience presence for the POC. Each Arena page sends an opaque
+// per-page client id; the host poll aggregates distinct non-host viewer pages
+// seen in the last 10 seconds. This is intentionally not identity: multiple
+// tabs from one person count separately, and the host page itself is excluded.
+// The Preview POC runs a single Fly machine so this in-process view is coherent.
+const PRESENCE_TTL_MS = 10_000;
+const PRESENCE_MAX_CLIENTS = 256;
+const PRESENCE_MAX_HOSTS = 8;
+const PRESENCE_CLIENT = /^[A-Za-z0-9_-]{8,64}$/;
+type PresenceRole = 'viewer' | 'host';
+const presenceBySession = new Map<string, Map<string, { role: PresenceRole; lastSeen: number }>>();
+
+function prunePresence(clients: Map<string, { role: PresenceRole; lastSeen: number }>, now: number): void {
+  for (const [client, entry] of clients) if (now - entry.lastSeen > PRESENCE_TTL_MS) clients.delete(client);
+  const viewers = [...clients.entries()].filter(([, entry]) => entry.role === 'viewer');
+  if (viewers.length > PRESENCE_MAX_CLIENTS) {
+    const oldest = viewers.sort((a, b) => a[1].lastSeen - b[1].lastSeen).slice(0, viewers.length - PRESENCE_MAX_CLIENTS);
+    for (const [client] of oldest) clients.delete(client);
+  }
+  const hosts = [...clients.entries()].filter(([, entry]) => entry.role === 'host');
+  if (hosts.length > PRESENCE_MAX_HOSTS) {
+    const oldest = hosts.sort((a, b) => a[1].lastSeen - b[1].lastSeen).slice(0, hosts.length - PRESENCE_MAX_HOSTS);
+    for (const [client] of oldest) clients.delete(client);
+  }
+}
