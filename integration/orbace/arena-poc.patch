+  app.post('/api/arena/sessions', { bodyLimit: 1024 }, async (request, reply) => {
+    if (!isArenaEnabled()) return sendDisabled(reply);
+    const hostUserId = await requireHost(request, reply);
+    if (!hostUserId) return;
+    if (request.headers.origin && !sameAllowedOrigin(request)) return reply.code(403).send({ error: 'Origin not allowed' });
+    const body = request.body as { defaultPreset?: unknown } | undefined;
+    const defaultPreset = body?.defaultPreset ?? 'quick';
+    if (!validPreset(defaultPreset)) return reply.code(400).send({ error: 'Invalid default time mode' });
+
+    const now = new Date();
+    const ballotClosesAt = new Date(now.getTime() + 60_000);
+    const expiresAt = new Date(now.getTime() + 2 * 60 * 60_000);
+    const session = await prisma.$transaction(async (tx) => {
+      const created = await tx.arenaSession.create({
+        data: { hostUserId, hostDefaultPreset: defaultPreset, ballotClosesAt, expiresAt },
+      });
+      await tx.arenaRound.create({ data: { sessionId: created.id, number: 1 } });
+      await appendEvent(tx, created.id, created.version, 'SESSION_CREATED', { status: created.status });
+      return tx.arenaSession.findUnique({ where: { id: created.id }, include: { rounds: true, votes: true } });
+    });
+    if (!session) return reply.code(500).send({ error: 'Could not create Arena session' });
+    return reply.code(201).send(projection(session, now));
+  });
+
+  // Flow 1 POC: six Arena pages poll read-only state. This relaxation is
+  // gated by ARENA_PREVIEW_PUBLIC_READS (Preview only) and still applies a
+  // per-client 40/min limit plus a 300/min per-IP cap. Production defaults
+  // to the normal global fallback; authorization, host allowlist, no-store,
+  // and every mutation limiter remain unchanged.
+  app.get<{ Params: { id: string } }>('/api/arena/sessions/:id', readRouteOptions(), async (request, reply) => {
+    if (!isArenaEnabled()) return sendDisabled(reply);
+    if (!SESSION_ID.test(request.params.id)) return reply.code(404).send({ error: 'Session not found' });
+    const session = await currentSession(request.params.id);
+    if (!session) return reply.code(404).send({ error: 'Session not found' });
+    notePresence(session.id, request, 'viewer');
+    reply.header('cache-control', 'no-store');
+    return projection(session, new Date());
+  });
+
+  app.get<{ Params: { id: string } }>('/api/arena/sessions/:id/overlay', readRouteOptions(), async (request, reply) => {
+    if (!isArenaEnabled()) return sendDisabled(reply);
+    if (!SESSION_ID.test(request.params.id)) return reply.code(404).send({ error: 'Session not found' });
+    const session = await currentSession(request.params.id);
+    if (!session) return reply.code(404).send({ error: 'Session not found' });
