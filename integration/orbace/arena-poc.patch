+  let clients = presenceBySession.get(sessionId);
+  if (!clients) {
+    clients = new Map();
+    presenceBySession.set(sessionId, clients);
+  }
+  const now = Date.now();
+  prunePresence(clients, now);
+  clients.set(client, { role, lastSeen: now });
+}
+
+function watchingCount(sessionId: string, now = Date.now()): number {
+  const clients = presenceBySession.get(sessionId);
+  if (!clients) return 0;
+  prunePresence(clients, now);
+  let watching = 0;
+  for (const entry of clients.values()) if (entry.role === 'viewer') watching += 1;
+  if (!clients.size) presenceBySession.delete(sessionId);
+  return watching;
+}
+
+function voterCount(session: SessionRow): number {
+  return new Set(session.votes.map((vote) => vote.guestKeyHash)).size;
+}
+
+// Host Notes/Pencil marks are public solving progress for the POC. They are
+// kept in memory on the single Preview API instance and returned with the
+// existing round projection; they are never persisted or used by solve
+// validation.
+const notesBySession = new Map<string, string[]>();
+function validNotes(value: unknown): value is string[] {
+  if (!Array.isArray(value) || value.length !== 81) return false;
+  for (const cell of value) {
+    if (typeof cell !== 'string' || !/^[1-9]{0,9}$/.test(cell)) return false;
+    if (new Set(cell).size !== cell.length) return false;
+  }
+  return true;
+}
+
+function anonymousVoterKeyHash(request: FastifyRequest, reply: FastifyReply): string {
+  let token = request.cookies?.[ANON_VOTER_COOKIE];
+  if (typeof token !== 'string' || !ANON_VOTER_TOKEN.test(token)) {
+    token = randomBytes(32).toString('base64url');
+    reply.setCookie(ANON_VOTER_COOKIE, token, {
