+    await prisma.arenaSession.update({ where: { id: dbSessionId }, data: { ballotClosesAt: new Date(Date.now() - 1_000) } });
+    const readyResponse = await app.inject({ method: 'GET', url: `/api/arena/sessions/${dbSessionId}` });
+    expect(readyResponse.json().status).toBe('READY');
+
+    const startedResponse = await app.inject({
+      method: 'POST', url: `/api/arena/sessions/${dbSessionId}/start`,
+      headers: { 'idempotency-key': 'arena-start-local-1' }, payload: { expectedVersion: readyResponse.json().version },
+    });
+    expect(startedResponse.statusCode).toBe(200);
+    expect(startedResponse.json().round.preset).toBe('standard');
+
+    const publicSnapshot = await app.inject({ method: 'GET', url: `/api/arena/sessions/${dbSessionId}` });
+    expect(publicSnapshot.statusCode).toBe(200);
+    expect(publicSnapshot.body).not.toContain(puzzleSolution);
+    expect(publicSnapshot.body).not.toContain('arena-test-host');
+
+    const hostSnapshot = await app.inject({ method: 'GET', url: `/api/arena/sessions/${dbSessionId}/host` });
