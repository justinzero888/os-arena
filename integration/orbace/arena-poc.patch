+
+// Canonical voter identity: bearer auth exposes the Supabase UUID while
+// cookie auth can expose the tier1 UUID. Resolve both to the same player row
+// so one Orbace player cannot cast a second effective vote by switching
+// credential transport. Unlinked Supabase users fall back to their JWT subject.
+async function canonicalVoterKeyHash(voter: { sub: string; tier1Uuid?: string }): Promise<string> {
+  // Never include an empty OR branch: a Supabase JWT has no tier1Uuid, and
+  // { tier1Uuid: undefined } would otherwise let Prisma match an unrelated
+  // player row, collapsing distinct bearer users onto one vote key.
+  const where = voter.tier1Uuid
+    ? { OR: [{ tier1Uuid: voter.tier1Uuid }, { supabaseId: voter.sub }] }
+    : { supabaseId: voter.sub };
