+  const presetVotes = session.votes.filter((vote) => vote.kind === 'PRESET');
+  const strikeVotes = session.votes.filter((vote) => vote.kind === 'STRIKE');
+  const voteTotals = ballotClosed
+    ? Object.fromEntries(PRESET_IDS.map((preset) => [preset, presetVotes.filter((vote) => vote.choice === preset).length]))
+    : null;
+  const strikeClosed = round?.strikeStatus === 'RESOLVED' || round?.strikeStatus === 'VOID';
+  return {
+    id: session.id,
+    status: session.status,
+    version: session.version,
+    paused: Boolean(session.pausedAt),
+    pausedAt: session.pausedAt?.toISOString() ?? null,
+    ballot: {
+      closesAt: session.ballotClosesAt.toISOString(),
+      closed: ballotClosed,
+      voteCount: presetVotes.length,
+      totals: voteTotals,
+    },
+    round: round ? {
+      number: round.number,
+      phase: round.phase,
+      preset: round.preset,
+      givens: round.givens,
+      // A winning board is the stored solution. Keep it private even in the
+      // terminal projection returned to the host, guests, and overlay.
+      board: round.result === 'HOST' ? null : round.boardState,
+      boardRevision: round.boardRevision,
+      notes: notesBySession.get(session.id) ?? [],
+      startedAt: round.startedAt?.toISOString() ?? null,
+      deadlineAt: round.deadlineAt?.toISOString() ?? null,
+      result: round.result,
+      strike: {
+        status: round.strikeStatus,
+        opensAt: round.strikeOpenedAt?.toISOString() ?? null,
+        closesAt: round.strikeClosesAt?.toISOString() ?? null,
+        choice: round.strikeChoice,
+        counts: round.strikeStatus === 'OPEN' || strikeClosed
+          ? { penalty: strikeVotes.filter((vote) => vote.choice === 'PENALTY').length, spare: strikeVotes.filter((vote) => vote.choice === 'SPARE').length }
+          : null,
+      },
+      modifier: round.modifier,
+      modifierAppliedSeconds: round.modifierAppliedSeconds,
+    } : null,
+    priorSessionId: session.priorSessionId,
+  };
+}
+
+async function appendEvent(
+  tx: ArenaTransaction,
+  sessionId: string,
+  version: number,
+  type: string,
+  payload: Prisma.InputJsonValue,
+  commandKey?: string,
+): Promise<void> {
+  await tx.arenaEvent.create({ data: { sessionId, version, type, payload, commandKey } });
