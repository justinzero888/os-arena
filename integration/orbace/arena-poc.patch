+  // Fastify's default error serialization echo those values to a client.
+  app.setErrorHandler((error, _request, reply) => {
+    const code = typeof error === 'object' && error !== null && 'statusCode' in error ? error.statusCode : undefined;
+    const status = typeof code === 'number' && Number.isInteger(code) && code >= 400 && code < 500 ? code : 503;
+    const message = status === 503 ? 'Arena is temporarily unavailable'
