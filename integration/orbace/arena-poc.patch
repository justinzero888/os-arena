+  let prisma: typeof import('../../lib/prisma.js').prisma;
+  let arenaRoutes: typeof import('../arena.routes.js').arenaRoutes;
+  const sessionIds: string[] = [];
+
+  beforeAll(async () => {
+    const url = new URL(databaseUrl!);
+    if (!['127.0.0.1', 'localhost', '[::1]'].includes(url.hostname) || url.pathname !== '/arena_app') {
+      throw new Error('ARENA_TEST_DATABASE_URL must point to a local database named arena_app');
+    }
+    process.env.DATABASE_URL = databaseUrl;
+    process.env.ARENA_ENABLED = 'true';
+    process.env.ARENA_ALLOWED_HOST_IDS = 'arena-test-host';
+    const prismaModule = await import('../../lib/prisma.js');
+    prisma = prismaModule.prisma;
+    ({ arenaRoutes } = await import('../arena.routes.js'));
+    await prisma.arenaPuzzleSupply.deleteMany({ where: { id: puzzleId } });
+    await prisma.arenaPuzzleSupply.create({
+      data: { id: puzzleId, tier: 'Extreme', givens: puzzleGivens, solution: puzzleSolution, eligible: true, provenance: 'TEST_FIXTURE' },
+    });
+  }, 15_000);
+
+  afterAll(async () => {
+    if (sessionIds.length) await prisma.arenaSession.deleteMany({ where: { id: { in: sessionIds } } });
+    if (prisma) {
+      await prisma.arenaPuzzleSupply.deleteMany({ where: { id: puzzleId } });
