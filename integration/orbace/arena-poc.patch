+
+  async function refresh() {
+    if (!sessionId || busy) return;
+    try {
+      let session;
+      let isHost = false;
+      if (overlayMode) {
+        session = await callApi('getArenaOverlay', sessionId, presenceClient);
+      } else if (hostProbe === 'host') {
+        try {
+          session = await callApi('getArenaHostSession', sessionId, presenceClient);
+          isHost = true;
+        } catch (error) {
+          if (error.status !== 401 && error.status !== 403 && error.status !== 404) throw error;
+          hostProbe = 'not-host';
+          session = await callApi('getArenaSession', sessionId, presenceClient);
+        }
+      } else if (hostProbe === 'not-host') {
+        session = await callApi('getArenaSession', sessionId, presenceClient);
+      } else {
+        try {
+          session = await callApi('getArenaHostSession', sessionId, presenceClient);
+          isHost = true;
+          hostProbe = 'host';
+        } catch (error) {
+          if (error.status !== 401 && error.status !== 403 && error.status !== 404) throw error;
+          hostProbe = 'not-host';
+          session = await callApi('getArenaSession', sessionId, presenceClient);
+        }
+      }
+      render(session, isHost);
+      resetError();
+    } catch (error) {
+      showError(error);
+    }
+  }
+
+  async function createSession() {
+    if (busy) return;
+    busy = true; resetError(); ui.create.disabled = true;
+    try {
+      const session = await callApi('createArenaSession', ui.preset.value);
+      setSessionUrl(session.id);
+      hostProbe = 'host';
+      render(session, true);
+      if (!pollId) pollId = setInterval(refresh, POLL_MS);
+    } catch (error) { showError(error); }
+    finally { busy = false; ui.create.disabled = false; }
+  }
+
+  async function joinSession() {
+    const raw = ui.sessionInput.value.trim();
+    const match = raw.match(/[0-9a-f]{8}-[0-9a-f-]{27}/i);
+    if (!match) { showError(new Error('Enter an Arena session ID or link.')); return; }
+    setSessionUrl(match[0]);
+    resetError();
+    await refresh();
+    if (!pollId) pollId = setInterval(refresh, POLL_MS);
+  }
+
+  async function vote(choice) {
+    if (!sessionId || busy || !accepted || accepted.status !== 'BALLOT_OPEN' || overlayMode) return;
+    busy = true; resetError();
+    try {
+      const session = await callApi('castArenaPresetVote', sessionId, choice);
+      lastVote = choice;
+      render(session, hostCanControl);
+      ui.voteMessage.textContent = 'Your vote is recorded. You can change it until the ballot closes.';
+    } catch (error) { showError(error); }
+    finally { busy = false; }
+  }
+
+  async function strikeVote(choice) {
+    if (!sessionId || busy || hostCanControl || overlayMode || !accepted || accepted.round?.strike?.status !== 'OPEN') return;
+    busy = true; resetError();
+    try {
+      const session = await callApi('castArenaStrikeVote', sessionId, choice);
+      lastStrikeVote = choice;
+      render(session, false);
+      ui.strikeMessage.textContent = 'Vote recorded. Spare wins ties; zero votes means Spare.';
+    } catch (error) { showError(error); }
+    finally { busy = false; }
+  }
+
+  async function startRound() {
+    if (!sessionId || busy || !accepted || !['BALLOT_OPEN', 'READY'].includes(accepted.status)) return;
+    busy = true; ui.start.disabled = true; resetError();
+    try {
+      const session = await callApi('startArenaRound', sessionId, accepted.version, idempotencyKey('start'));
+      render(session, true);
+    } catch (error) {
+      busy = false;
+      showError(error);
+      let latest = null;
+      try { latest = await callApi('getArenaHostSession', sessionId, presenceClient); } catch (_) {}
+      if (latest) render(latest, true);
+      if (error.status === 409 && latest && ['BALLOT_OPEN', 'READY'].includes(latest.status) && !latest.paused) {
+        try { render(await callApi('startArenaRound', sessionId, latest.version, idempotencyKey('start')), true); resetError(); }
+        catch (retryError) { showError(retryError); }
+      }
+    } finally { busy = false; }
+  }
+
+  async function solve() {
+    if (!sessionId || busy || !accepted || accepted.status !== 'PLAYING' || !hostCanControl || board.includes('0')) return;
+    busy = true; ui.solve.disabled = true; resetError();
+    try {
+      const session = await callApi('submitArenaSolve', sessionId, accepted.version, board, idempotencyKey('solve'));
+      render(session, true);
+    } catch (error) { showError(error); await refresh(); }
+    finally { busy = false; }
+  }
+
+  function scheduleBoardSync() {
+    if (!sessionId || busy || !accepted || accepted.status !== 'PLAYING' || !hostCanControl || accepted.paused || board.length !== 81) return;
+    // Never persist a complete candidate through the public board projection.
+    // A complete board is sent only to the private, server-validated solve route.
+    if (!board.includes('0')) {
+      clearTimeout(boardSyncTimer);
+      boardPending = false;
+      ui.solve.disabled = false;
+      return;
+    }
+    boardPending = true;
+    ui.solve.disabled = true;
+    clearTimeout(boardSyncTimer);
+    boardSyncTimer = setTimeout(async () => {
+      const snapshot = board;
+      const notesSnapshot = notes.map((cell) => Array.from(cell).sort().join(''));
+      try {
+        const session = await callApi('updateArenaBoard', sessionId, accepted.round?.boardRevision || 0, snapshot, idempotencyKey('board'), notesSnapshot);
+        if (session.id === acceptedSessionId && (!accepted || session.version >= accepted.version)) accepted = session;
+        boardPending = false;
+        if (board !== snapshot) scheduleBoardSync();
+        else ui.solve.disabled = !hostCanControl || Boolean(accepted?.paused) || board.includes('0');
+      } catch (error) {
+        boardPending = false;
+        showError(error);
+        ui.solve.disabled = true;
+      }
+    }, 220);
+  }
+
+  async function pauseRound() {
+    if (!accepted || !window.confirm('Pause the Arena for a technical issue?')) return;
+    try { render(await callApi('pauseArenaSession', sessionId, accepted.version, idempotencyKey('pause')), true); }
+    catch (error) { showError(error); await refresh(); }
+  }
+
+  async function resumeRound() {
+    if (!accepted || !window.confirm('Resume the Arena clock?')) return;
+    try { render(await callApi('resumeArenaSession', sessionId, accepted.version, idempotencyKey('resume')), true); }
+    catch (error) { showError(error); await refresh(); }
+  }
+
+  async function cancelSession() {
+    if (!accepted || !window.confirm('Cancel this Arena? It will end with no winner.')) return;
+    try { render(await callApi('cancelArenaSession', sessionId, accepted.version, idempotencyKey('cancel')), true); }
+    catch (error) { showError(error); await refresh(); }
+  }
+
+  async function rematch() {
+    if (!hostCanControl || !accepted || accepted.status !== 'RESULT') return;
+    busy = true; resetError(); ui.rematch.disabled = true;
+    try {
+      const session = await callApi('rematchArenaSession', sessionId, accepted.version, idempotencyKey('rematch'));
+      setSessionUrl(session.id);
+      hostProbe = 'host';
+      render(session, true);
+      if (!pollId) pollId = setInterval(refresh, POLL_MS);
+    } catch (error) { showError(error); }
+    finally { busy = false; ui.rematch.disabled = false; }
+  }
+
+  async function checkAvailability() {
+    try {
+      const health = await callApi('getArenaHealth');
+      if (!health || health.enabled !== true) {
+        const error = new Error('Arena is currently disabled.');
+        error.status = 404;
+        throw error;
+      }
+      if (!sessionId) ui.status.textContent = 'Host a round or join an Arena with its session link.';
+      return true;
+    } catch (error) {
+      if (error.status === 404) {
+        ui.status.textContent = 'Arena is currently disabled.';
+        ui.startPanel.hidden = false;
+        ui.create.disabled = true;
+        ui.join.disabled = true;
+        return false;
+      }
+      ui.status.textContent = 'Arena service is unavailable.';
+      showError(error);
+      return false;
+    }
+  }
+
+  ui.create.addEventListener('click', createSession);
+  ui.join.addEventListener('click', joinSession);
+  ui.start.addEventListener('click', startRound);
+  ui.solve.addEventListener('click', solve);
+  ui.rematch.addEventListener('click', rematch);
+  ui.pause.addEventListener('click', pauseRound);
+  ui.resume.addEventListener('click', resumeRound);
+  ui.cancel.addEventListener('click', cancelSession);
+  document.querySelectorAll('[data-vote]').forEach((button) => button.addEventListener('click', () => vote(button.dataset.vote)));
+  document.querySelectorAll('[data-strike-vote]').forEach((button) => button.addEventListener('click', () => strikeVote(button.dataset.strikeVote)));
+  if (ui.notes) ui.notes.addEventListener('click', () => { notesMode = !notesMode; renderNotesMode(); renderNotes(); });
+
+  // Keep the existing sign-in return-to mechanism (js/app.js) pointing at
+  // Arena when the sign-in link is used from this page; otherwise /signin
+  // defaults to /account after authentication.
+  const signInLink = document.getElementById('arena-signin');
+  if (signInLink) signInLink.addEventListener('click', stashArenaReturnTo);
+
+  checkAvailability().then((enabled) => {
+    if (!enabled) return;
+    if (sessionId) {
+      ui.sessionInput.value = sessionId;
+      setSessionUrl(sessionId);
+      ui.startPanel.hidden = true;
+      ui.sessionPanel.hidden = false;
+      refresh();
+      pollId = setInterval(refresh, POLL_MS);
+    } else {
+      ui.startPanel.hidden = false;
+    }
+  });
+  window.addEventListener('pagehide', () => { clearInterval(timerId); clearInterval(pollId); });
+  // Re-detect host state after a reconnect without probing on every poll.
+  window.addEventListener('online', () => {
+    hostProbe = 'unknown';
+    if (sessionId && !overlayMode) refresh();
+  });
+})();
