+// Arena pilot: server-owned gameplay records. ArenaRound.solution is private
+// backend state and must never be returned from the Arena route projections.
+// The API's Prisma connection is the only supported access path; the matching
+// SQL migration enables RLS without client-facing policies.
+// Curated, backend-only Arena supply. No rows are eligible by default.
+model ArenaPuzzleSupply {
+  id        String   @id @default(uuid()) @db.Uuid
+  tier      String
+  givens    String
+  solution  String
+  eligible  Boolean  @default(false)
+  provenance String  @default("UNSPECIFIED")
+  createdAt DateTime @default(now()) @map("created_at")
+
+  @@index([tier, eligible])
+  @@map("arena_puzzle_supply")
+}
+
+model ArenaSession {
+  id                String              @id @default(uuid()) @db.Uuid
+  seriesId          String              @default(uuid()) @map("series_id") @db.Uuid
+  priorSessionId    String?             @unique @map("prior_session_id") @db.Uuid
+  hostUserId        String              @map("host_user_id")
+  status            String              @default("BALLOT_OPEN")
+  version           Int                 @default(1)
+  hostDefaultPreset String              @default("quick") @map("host_default_preset")
+  ballotClosesAt    DateTime            @map("ballot_closes_at")
+  pausedAt          DateTime?           @map("paused_at")
+  pausedPhase       String?             @map("paused_phase")
+  createdAt         DateTime            @default(now()) @map("created_at")
+  updatedAt         DateTime            @updatedAt @map("updated_at")
+  expiresAt         DateTime            @map("expires_at")
+  rounds            ArenaRound[]
+  votes             ArenaVote[]
+  events            ArenaEvent[]
+  solveIngresses    ArenaSolveIngress[]
+  priorSession      ArenaSession?       @relation("ArenaRematches", fields: [priorSessionId], references: [id], onDelete: SetNull)
+  rematch           ArenaSession?       @relation("ArenaRematches")
+
+  @@index([hostUserId, createdAt], map: "arena_sessions_host_created_idx")
+  @@index([status, expiresAt], map: "arena_sessions_status_expiry_idx")
+  @@index([seriesId, createdAt], map: "arena_sessions_series_created_idx")
+  @@map("arena_sessions")
+}
+
+model ArenaRound {
+  id                     String       @id @default(uuid()) @db.Uuid
+  sessionId              String       @map("session_id") @db.Uuid
+  number                 Int
+  phase                  String       @default("BALLOT")
+  preset                 String?
+  puzzleId               String?      @map("puzzle_id")
+  givens                 String?
+  solution               String?
+  boardState             String?      @map("board_state")
+  boardRevision          Int          @default(0) @map("board_revision")
+  startedAt              DateTime?    @map("started_at")
+  deadlineAt             DateTime?    @map("deadline_at")
+  endedAt                DateTime?    @map("ended_at")
+  result                 String?
+  modifier               String?
+  modifierAppliedSeconds Int          @default(0) @map("modifier_applied_seconds")
+  strikeStatus           String       @default("NOT_OPEN") @map("strike_status")
+  strikeOpenedAt         DateTime?    @map("strike_opened_at")
+  strikeClosesAt         DateTime?    @map("strike_closes_at")
+  strikeResolvedAt       DateTime?    @map("strike_resolved_at")
+  strikeChoice           String?      @map("strike_choice")
+  pausedDurationMs       Int          @default(0) @map("paused_duration_ms")
+  createdAt              DateTime     @default(now()) @map("created_at")
+  session                ArenaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
+
+  @@unique([sessionId, number], map: "arena_rounds_session_number_key")
+  @@index([sessionId, phase], map: "arena_rounds_session_phase_idx")
+  @@map("arena_rounds")
+}
+
+model ArenaVote {
+  id           String       @id @default(uuid()) @db.Uuid
+  sessionId    String       @map("session_id") @db.Uuid
+  guestKeyHash String       @map("guest_key_hash")
+  kind         String       @default("PRESET")
+  choice       String
+  createdAt    DateTime     @default(now()) @map("created_at")
+  updatedAt    DateTime     @updatedAt @map("updated_at")
+  session      ArenaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
+
+  @@unique([sessionId, kind, guestKeyHash], map: "arena_votes_session_kind_guest_key")
+  @@index([sessionId, choice], map: "arena_votes_session_choice_idx")
+  @@map("arena_votes")
+}
+
+model ArenaEvent {
+  id         String       @id @default(uuid()) @db.Uuid
+  sessionId  String       @map("session_id") @db.Uuid
+  version    Int
+  commandKey String?      @map("command_key")
+  type       String
+  payload    Json
+  createdAt  DateTime     @default(now()) @map("created_at")
+  session    ArenaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
+
+  @@unique([sessionId, version], map: "arena_events_session_version_key")
+  @@unique([sessionId, commandKey], map: "arena_events_session_command_key")
+  @@index([sessionId, createdAt], map: "arena_events_session_created_idx")
+  @@map("arena_events")
+}
+
+model ArenaSolveIngress {
+  id             String       @id @default(uuid()) @db.Uuid
+  sessionId      String       @map("session_id") @db.Uuid
+  ingressAt      DateTime     @map("ingress_at")
+  leaseExpiresAt DateTime     @map("lease_expires_at")
+  session        ArenaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
+
+  @@index([sessionId, ingressAt, leaseExpiresAt], map: "arena_solve_ingresses_session_ingress_lease_idx")
+  @@map("arena_solve_ingresses")
+}
+
