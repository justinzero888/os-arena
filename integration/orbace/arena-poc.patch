+  standard: { tier: 'Extreme', seconds: 300 },
+  endurance: { tier: 'Extreme', seconds: 480 },
+} as const;
+
+// POC Preview-only read polling relaxation. When the flag is off (the
+// default, including production), the normal global fallback applies. When it
+// is on, read-only Arena GETs get a per-client 40/min limit plus a 300/min
+// per-IP cap; mutations and all other routes keep their existing limits.
+const PREVIEW_PUBLIC_READS = process.env.ARENA_PREVIEW_PUBLIC_READS === 'true';
+const ARENA_READ_CLIENT = /^[A-Za-z0-9_-]{8,64}$/;
+function arenaIpKey(request: FastifyRequest): string {
+  const flyIp = request.headers['fly-client-ip'];
+  return typeof flyIp === 'string' && flyIp ? flyIp : request.ip;
+}
+function arenaClientOrIpKey(request: FastifyRequest): string {
+  const raw = request.headers['x-arena-client'];
+  if (typeof raw === 'string' && ARENA_READ_CLIENT.test(raw)) return raw;
+  return arenaIpKey(request);
+}
+// Preview-only per-client read counter. The existing route config applies a
+// 300/min per-IP cap; this adds the requested 40/min per-client limit without
+// a second rate-limit plugin hook (the plugin marks a request as already
+// limited, which would skip a second hook). The map is bounded and oldest
+// entries are evicted; stale windows are reset on the next request.
+const PREVIEW_READ_CLIENT_MAX = 40;
+const PREVIEW_READ_CLIENT_WINDOW_MS = 60_000;
+const PREVIEW_READ_CLIENT_CAP = 4096;
+const previewReadClients = new Map<string, { start: number; count: number }>();
+async function previewReadClientLimit(request: FastifyRequest, reply: FastifyReply): Promise<void> {
+  if (!PREVIEW_PUBLIC_READS) return;
+  const key = arenaClientOrIpKey(request);
+  const now = Date.now();
+  const entry = previewReadClients.get(key);
+  if (!entry || now - entry.start >= PREVIEW_READ_CLIENT_WINDOW_MS) {
+    previewReadClients.set(key, { start: now, count: 1 });
+    if (previewReadClients.size > PREVIEW_READ_CLIENT_CAP) {
+      const oldest = [...previewReadClients.entries()].sort((a, b) => a[1].start - b[1].start).slice(0, previewReadClients.size - PREVIEW_READ_CLIENT_CAP);
+      for (const [client] of oldest) previewReadClients.delete(client);
+    }
+    return;
+  }
+  entry.count += 1;
+  if (entry.count > PREVIEW_READ_CLIENT_MAX) {
+    reply.code(429).send({ error: 'Too many requests' });
+    return;
+  }
+}
+
+type PresetId = (typeof PRESET_IDS)[number];
+type VoteKind = 'PRESET' | 'STRIKE';
+type ArenaTransaction = Prisma.TransactionClient;
+type SessionRow = Prisma.ArenaSessionGetPayload<{ include: { rounds: true; votes: true } }>;
