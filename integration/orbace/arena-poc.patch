+      const ticket = solveTickets.get(request);
+      if (ticket) {
+        // Fastify has finished reading/parsing the entire body. A body-read
+        // timeout must never release this ticket while adjudication waits.
+        clearTimeout(ticket.timeout);
+        ticket.adjudicating = true;
+      }
+    },
+    onRequestAbort: async (request) => { await releaseSolveTicket(request); },
+    onResponse: async (request) => {
+      await releaseSolveTicket(request, true);
+    },
+  }, async (request, reply) => {
+    if (!isArenaEnabled()) return sendDisabled(reply);
+    const ticket = solveTickets.get(request);
+    if (!ticket) return reply.code(404).send({ error: 'Session not found' });
+    const hostUserId = ticket.hostUserId;
+    const commandKey = parseIdempotencyKey(request)!;
+    const body = request.body as { expectedVersion?: unknown; board?: unknown } | undefined;
+    const expectedVersion = body?.expectedVersion;
+    if (typeof expectedVersion !== 'number' || !Number.isSafeInteger(expectedVersion)) return reply.code(400).send({ error: 'expectedVersion required' });
+    const ingressAt = ticket.ingressAt;
+    try {
+      const result = await prisma.$transaction(async (tx) => {
+        const session = await lockSession(tx, request.params.id);
+        if (!session || session.hostUserId !== hostUserId) return { code: 404 as const, session: null };
+        const existing = await tx.arenaEvent.findFirst({ where: { sessionId: request.params.id, commandKey } });
+        if (existing) return { code: existing.type === 'ROUND_SOLVED' ? 200 as const : 409 as const, session };
+        const round = session.rounds[0];
+        if (session.status !== 'PLAYING' || session.pausedAt || !round?.deadlineAt || !round.givens || !round.solution) return { code: 409 as const, session };
+        if (session.version !== expectedVersion) return { code: 409 as const, session };
+        if (ingressAt.getTime() >= round.deadlineAt.getTime()) return { code: 409 as const, session };
+        if (!isBoardSolution(body?.board, round.givens, round.solution)) {
+          if (validPartialBoard(body?.board, round.givens)) {
+            const version = session.version + 1;
+            await tx.arenaRound.update({ where: { id: round.id }, data: { boardState: body!.board as string, boardRevision: round.boardRevision + 1 } });
+            await tx.arenaSession.update({ where: { id: session.id }, data: { version } });
+            await appendEvent(tx, session.id, version, 'BOARD_UPDATED', { revision: round.boardRevision + 1 });
+            return { code: 422 as const, session: await lockSession(tx, session.id) };
+          }
+          return { code: 422 as const, session };
+        }
+        const version = session.version + 1;
+        await tx.arenaRound.update({ where: { id: round.id }, data: {
+          phase: 'RESULT', result: 'HOST', endedAt: new Date(), boardState: body!.board as string,
+          boardRevision: round.boardRevision + 1, strikeStatus: 'VOID',
+        } });
+        await tx.arenaSession.update({ where: { id: session.id }, data: { status: 'RESULT', version } });
+        await appendEvent(tx, session.id, version, 'ROUND_SOLVED', { result: 'HOST' }, commandKey);
+        return { code: 200 as const, session: await lockSession(tx, session.id) };
+      }, TRANSACTION_OPTIONS);
+      if (!result.session) return reply.code(result.code).send({ error: 'Session not found' });
+      if (result.code !== 200) return reply.code(result.code).send({ error: result.code === 422 ? 'Board is not the solution' : 'Solve was not accepted', ...(result.session ? { version: result.session.version } : {}) });
+      return projection(result.session, new Date());
+    } finally {
+      await releaseSolveTicket(request, true);
+    }
+  });
+}
diff --git a/backend/org-api/src/services/__tests__/arena-event-retention.service.test.ts b/backend/org-api/src/services/__tests__/arena-event-retention.service.test.ts
new file mode 100644
