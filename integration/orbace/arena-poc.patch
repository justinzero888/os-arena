@@ -0,0 +1,33 @@
+import { describe, expect, it, vi } from 'vitest';
+import { purgeOldArenaEvents, readArenaEventRetentionDays } from '../arena-event-retention.service.js';
+
+describe('Arena event retention', () => {
+  it.each([undefined, '', '0', '8', '30', '7days', ' 7'])('fails closed for invalid retention setting %j', (value) => {
+    const env = {} as NodeJS.ProcessEnv;
+    if (value !== undefined) env.ARENA_EVENT_RETENTION_DAYS = value;
+    expect(readArenaEventRetentionDays(env)).toBeNull();
+  });
+
+  it('accepts only a whole-number window from one through seven days', () => {
+    expect(readArenaEventRetentionDays({ ARENA_EVENT_RETENTION_DAYS: '7' } as NodeJS.ProcessEnv)).toBe(7);
+    expect(readArenaEventRetentionDays({ ARENA_EVENT_RETENTION_DAYS: '1' } as NodeJS.ProcessEnv)).toBe(1);
+  });
+
+  it('purges only events older than the configured maximum window', async () => {
+    const deleteMany = vi.fn(async () => ({ count: 3 }));
+    const now = new Date('2026-10-29T12:00:00.000Z');
+    const result = await purgeOldArenaEvents({ arenaEvent: { deleteMany } }, now, 7);
+    expect(result).toEqual({ enabled: true, retentionDays: 7, deleted: 3 });
+    expect(deleteMany).toHaveBeenCalledWith({
+      where: { createdAt: { lt: new Date('2026-10-22T12:00:00.000Z') } },
+    });
+  });
+
+  it('does not query when retention is unset or greater than seven days', async () => {
+    const deleteMany = vi.fn(async () => ({ count: 0 }));
+    const db = { arenaEvent: { deleteMany } };
+    expect(await purgeOldArenaEvents(db, new Date(), null)).toEqual({ enabled: false, retentionDays: null, deleted: 0 });
+    expect(await purgeOldArenaEvents(db, new Date(), 8)).toEqual({ enabled: false, retentionDays: null, deleted: 0 });
+    expect(deleteMany).not.toHaveBeenCalled();
+  });
+});
diff --git a/backend/org-api/src/services/arena-event-retention.service.ts b/backend/org-api/src/services/arena-event-retention.service.ts
new file mode 100644
index 00000000..b8077602
--- /dev/null
+++ b/backend/org-api/src/services/arena-event-retention.service.ts
@@ -0,0 +1,25 @@
+/** Arena events can include short-lived staging identifiers. Retention is
+ * disabled unless explicitly set, and values above the owner-approved
+ * seven-day ceiling fail closed instead of silently extending retention. */
+export interface ArenaEventRetentionDb {
+  arenaEvent: { deleteMany(args: unknown): Promise<{ count: number }> };
+}
+
+export function readArenaEventRetentionDays(env: NodeJS.ProcessEnv = process.env): number | null {
+  const raw = env.ARENA_EVENT_RETENTION_DAYS;
+  if (!raw || !/^[1-7]$/.test(raw)) return null;
+  return Number(raw);
+}
+
+export async function purgeOldArenaEvents(
+  db: ArenaEventRetentionDb,
+  now: Date,
+  retentionDays: number | null,
+): Promise<{ enabled: boolean; retentionDays: number | null; deleted: number }> {
+  if (retentionDays === null || !Number.isInteger(retentionDays) || retentionDays < 1 || retentionDays > 7) {
+    return { enabled: false, retentionDays: null, deleted: 0 };
+  }
+  const cutoff = new Date(now.getTime() - retentionDays * 24 * 60 * 60 * 1000);
+  const result = await db.arenaEvent.deleteMany({ where: { createdAt: { lt: cutoff } } });
+  return { enabled: true, retentionDays, deleted: result.count };
+}
