+
+async function releaseSolveTicket(request: FastifyRequest, finished = false): Promise<void> {
+  const ticket = solveTickets.get(request);
+  if (!ticket) return;
+  // A disconnected browser does not cancel a complete, eligible solve.
+  // Only handler completion (or an actual response) releases adjudication.
+  if (ticket.adjudicating && !finished) return;
+  // Delete from the registry before awaiting Prisma so finally/onResponse
+  // races become an exactly-once cleanup operation.
+  solveTickets.delete(request);
+  clearTimeout(ticket.timeout);
+  await prisma.arenaSolveIngress.deleteMany({ where: { id: ticket.id } }).catch(() => undefined);
+}
+
+function sendDisabled(reply: FastifyReply): void {
+  reply.code(404).send({ error: 'Not found' });
+}
+
+async function requireHost(request: FastifyRequest, reply: FastifyReply): Promise<string | null> {
+  const user = await authenticate(request, reply);
+  if (!user) return null;
+  if (!arenaHostAllowlist().has(user.sub)) {
+    reply.code(403).send({ error: 'Arena host access is not enabled for this account' });
+    return null;
+  }
