+
+async function advanceLockedSession(tx: ArenaTransaction, id: string, now: Date): Promise<SessionRow | null> {
+  let session = await lockSession(tx, id);
+  if (!session || session.pausedAt || ['RESULT', 'CANCELLED'].includes(session.status)) return session;
+  if (['BALLOT_OPEN', 'READY'].includes(session.status) && now.getTime() >= session.updatedAt.getTime() + 30 * 60_000) {
+    const version = session.version + 1;
+    const round = session.rounds[0];
+    if (round) await tx.arenaRound.update({ where: { id: round.id }, data: { phase: 'RESULT', result: 'CANCELLED', endedAt: now, strikeStatus: 'VOID' } });
+    await tx.arenaSession.update({ where: { id }, data: { status: 'CANCELLED', version } });
+    await appendEvent(tx, id, version, 'SESSION_IDLE_CANCELLED', { reason: 'IDLE_TTL' });
+    return lockSession(tx, id);
+  }
+  if (session.status === 'BALLOT_OPEN' && now >= session.ballotClosesAt) {
+    const version = session.version + 1;
+    await tx.arenaSession.update({ where: { id }, data: { status: 'READY', version } });
+    await appendEvent(tx, id, version, 'BALLOT_CLOSED', { voteCount: session.votes.filter((vote) => vote.kind === 'PRESET').length });
+    session = (await lockSession(tx, id))!;
+  }
+  if (session.status === 'PLAYING') {
+    let round = session.rounds[0];
+    if (round?.startedAt && round.preset && round.strikeStatus === 'NOT_OPEN') {
+      const triggerMs = PRESET_CONFIG[round.preset as PresetId].seconds * 1000 * 0.3;
+      const opensAt = new Date(round.startedAt.getTime() + triggerMs + round.pausedDurationMs);
+      if (now >= opensAt) {
+        const closesAt = new Date(opensAt.getTime() + 15_000);
+        await tx.arenaRound.update({ where: { id: round.id }, data: { strikeStatus: 'OPEN', strikeOpenedAt: opensAt, strikeClosesAt: closesAt } });
+        const version = session.version + 1;
+        await tx.arenaSession.update({ where: { id }, data: { version } });
+        await appendEvent(tx, id, version, 'STRIKE_BALLOT_OPENED', { closesAt: closesAt.toISOString(), variant: 'TIME_PENALTY' });
+        session = (await lockSession(tx, id))!;
+        round = session.rounds[0];
+      }
+    }
+    if (round?.strikeStatus === 'OPEN' && round.strikeClosesAt && now >= round.strikeClosesAt) {
+      const strikeVotes = session.votes.filter((vote) => vote.kind === 'STRIKE');
+      const penaltyVotes = strikeVotes.filter((vote) => vote.choice === 'PENALTY').length;
+      const spareVotes = strikeVotes.filter((vote) => vote.choice === 'SPARE').length;
+      const penaltyWon = penaltyVotes > spareVotes;
+      const remainingSeconds = Math.ceil(((round.deadlineAt?.getTime() ?? now.getTime()) - now.getTime()) / 1000);
+      const penaltySeconds = penaltyWon ? Math.min(10, Math.max(0, remainingSeconds - 30)) : 0;
+      const nextDeadline = round.deadlineAt && penaltySeconds > 0
+        ? new Date(round.deadlineAt.getTime() - penaltySeconds * 1000)
+        : round.deadlineAt;
+      await tx.arenaRound.update({ where: { id: round.id }, data: {
+        strikeStatus: 'RESOLVED', strikeResolvedAt: now,
+        strikeChoice: penaltyWon ? 'TIME_PENALTY' : 'SPARED',
+        modifier: penaltySeconds > 0 ? 'TIME_PENALTY' : 'NONE',
+        modifierAppliedSeconds: penaltySeconds,
+        ...(nextDeadline ? { deadlineAt: nextDeadline } : {}),
+      } });
+      const version = session.version + 1;
+      await tx.arenaSession.update({ where: { id }, data: { version } });
+      await appendEvent(tx, id, version, penaltySeconds > 0 ? 'TIME_PENALTY_APPLIED' : 'STRIKE_RESOLVED', {
+        choice: penaltyWon ? 'TIME_PENALTY' : 'SPARED', penaltySeconds,
+      });
+      session = (await lockSession(tx, id))!;
+      round = session.rounds[0];
+    }
+    if (round?.deadlineAt && now.getTime() >= round.deadlineAt.getTime() + DEADLINE_ADJUDICATION_GRACE_MS) {
+      const pending = await tx.arenaSolveIngress.count({
+        where: { sessionId: id, ingressAt: { lt: round.deadlineAt }, leaseExpiresAt: { gt: now } },
+      });
+      if (pending === 0) {
+        const version = session.version + 1;
+        await tx.arenaRound.update({ where: { id: round.id }, data: { phase: 'RESULT', result: 'AUDIENCE', endedAt: now, strikeStatus: ['OPEN', 'NOT_OPEN'].includes(round.strikeStatus) ? 'VOID' : round.strikeStatus } });
+        await tx.arenaSession.update({ where: { id }, data: { status: 'RESULT', version } });
+        await appendEvent(tx, id, version, 'ROUND_TIMEOUT', { result: 'AUDIENCE' });
+        session = (await lockSession(tx, id))!;
+      }
+    }
+  }
+  return session;
+}
+
+async function advanceSessionState(id: string, now: Date): Promise<SessionRow | null> {
+  return prisma.$transaction((tx) => advanceLockedSession(tx, id, now), TRANSACTION_OPTIONS);
+}
+
+async function currentSession(id: string): Promise<SessionRow | null> {
+  return advanceSessionState(id, new Date());
+}
+
+function validPartialBoard(board: unknown, givens: string): board is string {
+  if (typeof board !== 'string' || !/^[0-9]{81}$/.test(board)) return false;
+  for (let i = 0; i < 81; i += 1) if (givens[i] !== '0' && board[i] !== givens[i]) return false;
+  for (let i = 0; i < 81; i += 1) {
+    const digit = board[i];
+    if (digit === '0') continue;
+    const row = Math.floor(i / 9), col = i % 9, boxRow = Math.floor(row / 3) * 3, boxCol = Math.floor(col / 3) * 3;
+    for (let j = 0; j < 81; j += 1) {
+      if (j === i || board[j] !== digit) continue;
+      const otherRow = Math.floor(j / 9), otherCol = j % 9;
+      if (otherRow === row || otherCol === col || (Math.floor(otherRow / 3) * 3 === boxRow && Math.floor(otherCol / 3) * 3 === boxCol)) return false;
+    }
+  }
+  return true;
+}
+
+function parseIdempotencyKey(request: FastifyRequest): string | null {
+  const value = request.headers['idempotency-key'];
+  if (typeof value !== 'string' || !/^[A-Za-z0-9._:-]{8,128}$/.test(value)) return null;
+  return value;
+}
+
+function isBoardSolution(board: unknown, givens: string, solution: string): boolean {
+  if (typeof board !== 'string' || !/^[1-9]{81}$/.test(board)) return false;
+  for (let index = 0; index < 81; index += 1) {
+    if (givens[index] !== '0' && board[index] !== givens[index]) return false;
+  }
+  return board === solution;
+}
+
+export async function arenaRoutes(app: FastifyInstance): Promise<void> {
