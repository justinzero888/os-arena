@@ -314,6 +314,54 @@ export function isPuzzleIdentityFlagEnabled(flag: PuzzleIdentityFlag): boolean {
   }
 }

+/** Arena is independent of puzzle-identity flags and remains unavailable
+ * unless explicitly enabled in a local/test deployment. */
+export function isArenaEnabled(): boolean {
+  try {
+    return process.env.ARENA_ENABLED === 'true';
+  } catch {
+    return false;
+  }
+}
+
+/** Host authorization is deny-by-default. Entries are verified Orbace
+ * AuthenticatedUser.sub values, never client-supplied IDs. */
+export function arenaHostAllowlist(): ReadonlySet<string> {
+  try {
+    const raw = process.env.ARENA_ALLOWED_HOST_IDS;
+    if (!raw?.trim()) return new Set();
+    const values = raw.split(',').map((value) => value.trim()).filter(Boolean);
+    if (values.some((value) => value.length > 128)) return new Set();
+    return new Set(values);
+  } catch {
+    return new Set();
+  }
+}
+
+/** Exact browser origins authorized to call the Arena API. Empty by default.
+ * Values must be canonical origins (scheme + host + optional port), with no
+ * path, credentials, query, or fragment. This is intentionally separate from
+ * the global CORS list so Preview access cannot broaden unrelated APIs. */
+export function arenaAllowedOrigins(): ReadonlySet<string> {
+  try {
+    const raw = process.env.ARENA_ALLOWED_ORIGINS;
+    if (!raw?.trim() || raw.length > 2048) return new Set();
+    const values = raw.split(',').map((value) => value.trim());
+    if (values.some((value) => !value || value.length > 256)) return new Set();
+    const origins = values.map((value) => {
+      const parsed = new URL(value);
+      if (!['http:', 'https:'].includes(parsed.protocol) || parsed.origin !== value ||
+        parsed.username || parsed.password || parsed.pathname !== '/' || parsed.search || parsed.hash) {
+        throw new Error('invalid Arena origin');
+      }
+      return parsed.origin;
+    });
+    return new Set(origins);
+  } catch {
+    return new Set();
+  }
+}
+
