+  await tx.$queryRaw`SELECT id FROM arena_sessions WHERE id = ${id}::uuid FOR UPDATE`;
+  return tx.arenaSession.findUnique({
+    where: { id },
+    include: { rounds: { orderBy: { number: 'desc' } }, votes: true },
+  });
